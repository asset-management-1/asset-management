    <ItemGroup>
      <ProjectReference Include="..\..\Services\Authentications\Authentication.Api\Authentication.Api.csproj" />
      <ProjectReference Include="..\..\Services\Authentications\Authentication.Application\Authentication.Application.csproj" />
      <ProjectReference Include="..\..\Services\Authentications\Authentication.Domain\Authentication.Domain.csproj" />
      <ProjectReference Include="..\..\Services\Authentications\Authentication.Infrastructure\Authentication.Infrastructure.csproj" />
      <ProjectReference Include="..\..\Services\Businesses\Haven.Api\Haven.Api.csproj" />
      <ProjectReference Include="..\..\Services\Businesses\Haven.Application\Haven.Application.csproj" />
      <ProjectReference Include="..\..\Services\Businesses\Haven.Domain\Haven.Domain.csproj" />
      <ProjectReference Include="..\..\Services\Businesses\Haven.Infrastructure\Haven.Infrastructure.csproj" />
      <ProjectReference Include="..\..\Shared\Be.Haven.ApiCommon\Be.Haven.ApiCommon.csproj" />
      <ProjectReference Include="..\..\Shared\Be.Haven.Cache\Be.Haven.Cache.csproj" />
      <ProjectReference Include="..\..\Shared\Be.Haven.Core\Be.Haven.Core.csproj" />
      <ProjectReference Include="..\..\Shared\Be.Haven.Shared\Be.Haven.Shared.csproj" />
